{
    "name": "aliemami-coder/laravel-n-plus-one-scanner",
    "description": "Static AST analyzer package for Laravel to scan an entire project and detect N+1 query issues.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "n+1",
        "eloquent",
        "static-analysis",
        "performance",
        "ast"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "NPlusOneScanner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NPlusOneScanner\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NPlusOneScanner\\NPlusOneScannerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
